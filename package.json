{
  "name": "cv-optimizer",
  "version": "0.1.0",
  "description": "CV Optimizer - Job search companion",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --filter=@repo/app",
    "test": "turbo test",
    "check": "turbo check",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "npm run db:generate --workspace=@repo/database",
    "db:push": "npm run db:push --workspace=@repo/database",
    "db:studio": "npm run db:studio --workspace=@repo/database"
  },
  "dependencies": {},
  "devDependencies": {
    "turbo": "latest"
  }
}
