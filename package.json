{
  "name": "cv-optimizer",
  "version": "0.1.0",
  "description": "CV Optimizer - Job search companion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
