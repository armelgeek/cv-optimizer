{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env.local"],
  "globalEnv": ["PORT"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [".next/**", "dist/**", "build/**"],
      "cache": true
    },
    "//#build": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": true
    },
    "check": {
      "cache": true
    }
  }
}
